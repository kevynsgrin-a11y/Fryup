---
---
<header class="bg-stone-900 text-stone-100 border-b-4 border-amber-600 sticky top-0 z-40 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-3 group">
      <div class="w-10 h-10 bg-amber-600 rounded-full flex items-center justify-center font-serif text-2xl font-bold text-stone-950 group-hover:bg-amber-500 transition">
        F
      </div>
      <div>
        <span class="font-serif text-2xl font-bold tracking-tight text-stone-100 group-hover:text-amber-500 transition">FRYUP.UK</span>
        <span class="block text-xs uppercase tracking-widest text-amber-500 font-sans font-semibold">The Proper Fry-Up, Made at Home</span>
      </div>
    </a>

    <!-- Primary Desktop Nav -->
    <nav class="hidden md:flex items-center space-x-8 text-sm font-semibold tracking-wide">
      <a href="/recipes/" class="hover:text-amber-500 transition">RECIPES</a>
      <a href="/build-your-fry-up/" class="hover:text-amber-500 transition flex items-center gap-1 text-amber-400">
        <span>PLATE BUILDER</span>
        <span class="px-1.5 py-0.5 bg-amber-600/30 text-amber-400 text-xs rounded border border-amber-500/40">TOOL</span>
      </a>
      <a href="/fry-up-timer/" class="hover:text-amber-500 transition text-amber-400">TIMER</a>
      <a href="/guides/" class="hover:text-amber-500 transition">GUIDES</a>
      <a href="/history/" class="hover:text-amber-500 transition">HISTORY</a>
      <a href="/equipment/" class="hover:text-amber-500 transition">EQUIPMENT</a>
    </nav>

    <!-- Quick Actions -->
    <div class="flex items-center space-x-4">
      <a href="/search/" class="p-2 text-stone-300 hover:text-amber-500 transition" aria-label="Search recipes">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>
      <a href="/favourites/" class="p-2 text-stone-300 hover:text-amber-500 transition hidden sm:inline-block" aria-label="Saved favourites">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </a>
    </div>
  </div>
</header>
