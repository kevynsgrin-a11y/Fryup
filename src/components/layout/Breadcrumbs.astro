---
interface Item {
  label: string;
  url?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": item.url ? `https://fryup.uk${item.url}` : undefined
  }))
};
---

<nav aria-label="Breadcrumb" class="py-3 px-4 bg-stone-100/70 border-b border-stone-200 text-xs font-medium text-stone-600 mb-6 no-print">
  <ol class="max-w-7xl mx-auto flex items-center space-x-2 overflow-x-auto">
    <li>
      <a href="/" class="hover:text-amber-800 transition">Home</a>
    </li>
    {items.map((item) => (
      <li class="flex items-center space-x-2">
        <span class="text-stone-400">/</span>
        {item.url ? (
          <a href={item.url} class="hover:text-amber-800 transition">{item.label}</a>
        ) : (
          <span class="text-stone-900 font-semibold" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
