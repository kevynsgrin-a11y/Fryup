---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import PlateBuilder from '../components/tools/PlateBuilder';
---

<BaseLayout title="Build Your Fry-Up — Plate Builder & Timing Calculator | Fryup.UK" description="Interactive English breakfast planning tool. Select your ingredients, number of diners, and generate a synchronized step-by-step cooking timeline so everything arrives hot.">
  <Breadcrumbs items={[{ label: 'Build Your Fry-Up' }]} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PlateBuilder client:load />
  </div>
</BaseLayout>
