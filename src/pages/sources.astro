---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
---

<BaseLayout title="Culinary Source Register — Fryup.UK" description="Complete register of Tier 1-4 sources, academic food science texts, and FSA safety frameworks used on Fryup.UK.">
  <Breadcrumbs items={[{ label: 'Sources' }]} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <header class="space-y-4 border-b border-stone-200 pb-6">
      <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">ACADEMIC & CULINARY AUDIT</span>
      <h1 class="text-4xl font-serif font-bold text-stone-950">Culinary Source Register</h1>
      <p class="text-stone-600 text-base">
        Full list of primary literature, regulatory standards, food science texts, and historical archives supporting Fryup.UK recipes.
      </p>
    </header>

    <div class="space-y-6">
      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-2">
        <span class="px-2 py-0.5 bg-red-100 text-red-900 text-xs font-bold uppercase rounded">Tier 1 — Regulatory & Food Science</span>
        <h3 class="font-serif font-bold text-xl text-stone-900">UK Food Standards Agency (FSA)</h3>
        <p class="text-sm text-stone-600">Established safe internal core temperatures (pork sausages 75°C), British Lion egg safety guidelines, and 90-minute cooling rules for cooked breakfasts.</p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-2">
        <span class="px-2 py-0.5 bg-blue-100 text-blue-900 text-xs font-bold uppercase rounded">Tier 1 — Archival Literature</span>
        <h3 class="font-serif font-bold text-xl text-stone-900">Food in England (Dorothy Hartley, 1954)</h3>
        <p class="text-sm text-stone-600">Historical documentation of traditional fried bread lard rendering, cured pork cuts, and regional breakfast traditions across the British Isles.</p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-2">
        <span class="px-2 py-0.5 bg-emerald-100 text-emerald-900 text-xs font-bold uppercase rounded">Tier 2 — Professional Culinary</span>
        <h3 class="font-serif font-bold text-xl text-stone-900">Leiths School of Food and Wine Masterclasses</h3>
        <p class="text-sm text-stone-600">Sausage meat percentages, natural casing physics, and pan heat control for gentle Maillard browning without casing rupture.</p>
      </div>
    </div>
  </div>
</BaseLayout>
