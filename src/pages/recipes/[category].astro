---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  // Get all unique categories
  const categories = Array.from(new Set(recipes.map(r => r.data.recipeCategory)));
  
  return categories.map(category => {
    // Generate slug from category name
    const slug = category.toLowerCase().replace(/ /g, '-');
    return {
      params: { category: slug },
      props: { 
        categoryName: category,
        recipes: recipes.filter(r => r.data.recipeCategory === category)
      }
    };
  });
}

const { categoryName, recipes } = Astro.props;
---

<BaseLayout title={`${categoryName} Recipes — Fryup.UK`} description={`Browse all ${recipes.length} recipes in the ${categoryName} category for your perfect English breakfast.`}>
  <Breadcrumbs items={[
    { label: 'Recipes', url: '/recipes/' },
    { label: categoryName }
  ]} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <header class="space-y-4 border-b border-stone-200 pb-6">
      <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">CATEGORY ARCHIVE</span>
      <h1 class="text-4xl font-serif font-bold text-stone-950">{categoryName} Recipes</h1>
      <p class="text-stone-600 max-w-3xl text-base">
        Explore {recipes.length} complete recipes in this category with metric UK measurements, FSA food safety temperatures, and detailed step-by-step instructions.
      </p>
    </header>

    <!-- Recipe Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {recipes.map(recipe => (
        <a href={`/recipes/${recipe.data.slug}/`} class="group bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden hover:shadow-md transition">
          <div class="aspect-video bg-stone-100 overflow-hidden">
            <img src={recipe.data.heroImage} alt={recipe.data.imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          </div>
          <div class="p-5 space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 bg-amber-100 text-amber-900 text-[10px] font-bold uppercase rounded">{recipe.data.recipeCategory}</span>
              <span class="text-xs text-stone-500 font-mono">{recipe.data.totalTimeMinutes} Mins</span>
            </div>
            <h3 class="font-serif font-bold text-lg text-stone-900 group-hover:text-amber-700 transition">{recipe.data.title}</h3>
            <p class="text-xs text-stone-600 line-clamp-2">{recipe.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
