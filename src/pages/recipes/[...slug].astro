---
import { getCollection } from 'astro:content';
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import PacketArticle from '../../components/PacketArticle.astro';
import type { Packet } from '../../lib/packet-render';

const packets = import.meta.glob<{ default: Packet }>('../../content/packets/*.json', { eager: true });
const packetBySlug: Record<string, Packet> = {};
for (const mod of Object.values(packets)) {
  const p = mod.default;
  packetBySlug[p.meta.slug] = p;
}

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map(recipe => ({
    params: { slug: recipe.data.slug },
    props: { recipe }
  }));
}

const { recipe } = Astro.props;
const packet = packetBySlug[recipe.data.slug];
---

{
  packet ? (
    <PacketArticle
      packet={packet}
      title={recipe.data.title}
      description={recipe.data.description}
      heroImage={recipe.data.heroImage}
    />
  ) : (
    <RecipeLayout recipe={recipe} />
  )
}
