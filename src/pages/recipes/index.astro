---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
const categories = Array.from(new Set(recipes.map(r => r.data.recipeCategory)));
---

<BaseLayout title="All 84 English Breakfast Recipes — Fryup.UK" description="Browse 84 recipes for traditional full English breakfasts, sausages, back bacon, black pudding, eggs, baked beans, hash browns, and air fryer fry-ups.">
  <Breadcrumbs items={[{ label: 'Recipes' }]} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <header class="space-y-4 border-b border-stone-200 pb-6">
      <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">RECIPE LIBRARY</span>
      <h1 class="text-4xl font-serif font-bold text-stone-950">Complete English Breakfast Recipe Collection</h1>
      <p class="text-stone-600 max-w-3xl text-base">
        Explore 84 complete recipes with metric UK measurements, FSA food safety temperatures, and detailed step-by-step instructions.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2 pt-4">
        <a href="/recipes/" class="px-4 py-2 bg-stone-900 text-stone-100 rounded-full text-xs font-bold shadow">All (84)</a>
        {categories.map(cat => (
          <a href={`#cat-${cat.toLowerCase().replace(/ /g, '-')}`} class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-800 rounded-full text-xs font-semibold border border-stone-300 transition">
            {cat}
          </a>
        ))}
      </div>
    </header>

    <!-- Recipe Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {recipes.map(recipe => (
        <a href={`/recipes/${recipe.data.slug}/`} class="group bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden hover:shadow-md transition">
          <div class="aspect-video bg-stone-100 overflow-hidden">
            <img src={recipe.data.heroImage} alt={recipe.data.imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          </div>
          <div class="p-5 space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 bg-amber-100 text-amber-900 text-[10px] font-bold uppercase rounded">{recipe.data.recipeCategory}</span>
              <span class="text-xs text-stone-500 font-mono">{recipe.data.totalTimeMinutes} Mins</span>
            </div>
            <h3 class="font-serif font-bold text-lg text-stone-900 group-hover:text-amber-700 transition">{recipe.data.title}</h3>
            <p class="text-xs text-stone-600 line-clamp-2">{recipe.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
