---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
---

<BaseLayout title="The Best Pans & Equipment for a Fry-Up — Fryup.UK" description="Cast iron skillets vs non-stick pans, double-burner griddles, egg rings, and sheet pan reviews for cooking the perfect English breakfast.">
  <Breadcrumbs items={[{ label: 'Equipment' }]} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <header class="space-y-4 border-b border-stone-200 pb-6">
      <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">COOKWARE REVIEWS</span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-stone-950">The Best Pans & Equipment for a Fry-Up</h1>
      <p class="text-lg text-stone-600 font-serif italic">
        Tested cookware guides for heat retention, fat rendering, and simultaneous cooking.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white p-6 rounded-xl border border-stone-200 space-y-3">
        <h3 class="font-serif font-bold text-2xl text-stone-900">1. Heavy 30cm Cast Iron Skillet</h3>
        <p class="text-stone-600 text-sm leading-relaxed">
          The ultimate vessel for searing sausages, crisping black pudding, and frying bread. Superior thermal mass prevents heat drops when adding cold meats.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-stone-200 space-y-3">
        <h3 class="font-serif font-bold text-2xl text-stone-900">2. Double-Burner Cast-Iron Griddle</h3>
        <p class="text-stone-600 text-sm leading-relaxed">
          Ideal for large families or Sunday brunches. Spans two stovetop burners to create distinct high-heat sear zones and low-heat holding zones.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-stone-200 space-y-3">
        <h3 class="font-serif font-bold text-2xl text-stone-900">3. Non-Stick Egg & Pancake Pan</h3>
        <p class="text-stone-600 text-sm leading-relaxed">
          Essential for delicate soft-scrambled or foolproof fried eggs without sticking. Look for heavy-gauge aluminum with PFOA-free ceramic coating.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-stone-200 space-y-3">
        <h3 class="font-serif font-bold text-2xl text-stone-900">4. Rimmed Baking Sheet (Half Sheet)</h3>
        <p class="text-stone-600 text-sm leading-relaxed">
          Crucial for big-batch oven tray-bakes and holding cooked sausages warm at 100°C while finishing eggs on the stovetop.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
